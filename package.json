  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
